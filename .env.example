# Lumen Lab Environment Variables
# Copy to .env and fill in values

# Application
APP_NAME=Lumen Lab
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./lumen_lab.db

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=lumen-lab
KEYCLOAK_CLIENT_ID=lumen-lab-client
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# LLM (optional - configure for AI features)
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Benchmark defaults
BENCHMARK_OBSERVATION_TIMEOUT_MS=1000
BENCHMARK_SETTLE_TIMEOUT_MS=800
BENCHMARK_POLL_INTERVAL_MS=50